# Optional. Raises GitHub's rate limit from 60 to 5,000 requests an hour and
# unlocks the write-access signals the outsider/core-team split depends on.
# A classic token with NO scopes ticked is enough for public repositories.
#
# On a public deployment, leave this unset: it would be used for every visitor.
GITHUB_TOKEN=

# Analyses allowed per IP per 10 minutes. Worth lowering if GITHUB_TOKEN is set
# above, since then every visitor spends the same 5,000/hour limit.
ANALYSES_PER_10_MIN=25
